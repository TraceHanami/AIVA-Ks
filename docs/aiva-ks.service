[Unit]
Description=AIVA-KS AI-Powered Linux Kernel Security Daemon
Documentation=https://github.com/TraceHanami/AIVA-Ks
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/tracehanami/Github/AIVA-Ks
ExecStart=/home/tracehanami/Github/AIVA-Ks/.venv/bin/uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5s

# Security and Resource Guardrails
LimitNOFILE=65536
LimitNPROC=4096
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aiva-ks

[Install]
WantedBy=multi-user.target
